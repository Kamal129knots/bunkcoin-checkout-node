{
  "name": "bunkcoin-checkout",
  "version": "1.0.0",
  "description": "Bunk Coin top-up for 129Knots via Stripe embedded Checkout (API 2026-09-30.endive)",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "node --test",
    "webhooks": "stripe listen --events checkout.session.completed,checkout.session.async_payment_succeeded,checkout.session.async_payment_failed,checkout.session.expired --forward-to localhost:4242/webhooks/stripe"
  },
  "dependencies": {
    "express": "^5.3.0",
    "stripe": "^23.0.0"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9"
  }
}
